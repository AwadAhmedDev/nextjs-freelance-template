# Copie ce fichier en .env et remplis les valeurs.
# Ne versionne JAMAIS le fichier .env.
# Règle : aucune clé secrète ne commence par NEXT_PUBLIC_ (ces variables sont envoyées au navigateur).

# ─── Application ──────────────────────────────────────────────
# Adresse publique du site (sans "/" final)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Base de données (PostgreSQL) ─────────────────────────────
# En local : lancée par `docker compose up -d`
DATABASE_URL="postgresql://app:app@localhost:5432/app?schema=public"

# ─── Authentification (Better Auth) ───────────────────────────
# Génère un secret : openssl rand -base64 32
BETTER_AUTH_SECRET="remplace-moi-par-un-secret-de-32-caracteres-minimum"
BETTER_AUTH_URL="http://localhost:3000"

# Connexion Google (optionnelle) : console.cloud.google.com > Identifiants
# URL de redirection autorisée : {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Paiement (Stripe) ────────────────────────────────────────
# Clés de TEST en développement (sk_test_...). Tableau de bord Stripe > Développeurs.
STRIPE_SECRET_KEY=""
# En local : affiché par `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=""

# ─── Emails (Resend) ──────────────────────────────────────────
# Sans clé, les emails sont affichés dans la console (pratique en développement).
RESEND_API_KEY=""
EMAIL_FROM="Mon Site <contact@exemple.fr>"

# ─── Stockage objet (S3, Cloudflare R2, Scaleway) ────────────
# Sans ces valeurs, l'upload de fichiers est désactivé.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Adresse publique des fichiers (domaine du bucket ou CDN), utilisée par la CSP et pour afficher les images
S3_PUBLIC_ORIGIN=""

# ─── Divers ───────────────────────────────────────────────────
# Mettre à 1 uniquement pendant le build Docker (les secrets ne sont pas disponibles à ce moment-là)
SKIP_ENV_VALIDATION=""
